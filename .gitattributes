# Ensure shell scripts and PowerShell scripts always have LF line endings
# even on Windows. CRLF breaks bash and pwsh on Linux.
scripts/setup.sh    text eol=lf
scripts/setup.ps1   text eol=lf

# Source code - auto-detect
*.js    text
*.json  text
*.md    text
*.yaml  text
*.yml   text

# Binary files
*.png   binary
*.jpg   binary
*.ico   binary
