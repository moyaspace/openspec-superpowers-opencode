# npm pack artifact
*.tgz

# database
data/

# OS files
Thumbs.db
.DS_Store

# CodeGraph index cache
.codegraph/

# Playwright MCP
.playwright-mcp/

# Serena tool data
.serena/

# Build output (rebuilt by prepare before pack)
/dist/

# ↑ Manual gitignore entries go ABOVE this line (outside auto-generated block) ↑

