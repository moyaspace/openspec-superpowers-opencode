{
  "name": "@moyaspace/openspec-superpowers-opencode",
  "version": "1.1.1",
  "description": "Bridges Superpowers + OpenSpec workflows into OpenCode with enforced worktree isolation",
  "keywords": [
    "openspec",
    "superpowers",
    "opencode",
    "git-worktree",
    "workflow",
    "bridge",
    "spec-driven",
    "sdd",
    "ai-coding",
    "developer-tools",
    "parallel-development",
    "worktree",
    "cross-platform",
    "code-generation"
  ],
  "type": "module",
  "exports": {
    "./cli": {
      "types": "./dist/cli/index.d.ts",
      "default": "./dist/cli/index.js"
    }
  },
  "bin": {
    "create-openspec-superpowers-opencode": "dist/cli/create-project.js",
    "openspec-superpowers-opencode": "dist/cli/index.js",
    "oso": "dist/cli/index.js"
  },
  "files": [
    ".gitattributes",
    "assets/",
    "dist/",
    "template/",
    "template/_gitignore",
    "template/.gitattributes",
    "test/",
    "!test/host-probe/node_modules",
    "!test/host-probe/dist",
    "!test/elevated",
    "!test/*.elevated.*",
    "scripts/",
    "docs/QUICKSTART.md",
    "LICENSE"
  ],
  "scripts": {
    "install": "node scripts/shims-installer.mjs install",
    "test": "node scripts/run-tests.mjs node --test \"test/*.test.js\"",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "author": "rl <robincn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyaspace/openspec-superpowers-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/moyaspace/openspec-superpowers-opencode/issues"
  },
  "homepage": "https://github.com/moyaspace/openspec-superpowers-opencode#readme",
  "publishConfig": {
    "access": "public"
  }
}
