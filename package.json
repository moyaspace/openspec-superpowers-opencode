{
  "name": "@moyaspace/openspec-superpowers-opencode",
  "version": "1.1.1",
  "description": "Bridges Superpowers + OpenSpec workflows into OpenCode with enforced worktree isolation",
  "keywords": [
    "openspec",
    "superpowers",
    "opencode",
    "git-worktree",
    "workflow",
    "bridge",
    "spec-driven",
    "sdd",
    "ai-coding",
    "developer-tools",
    "parallel-development",
    "worktree",
    "cross-platform",
    "code-generation"
  ],
  "type": "module",
  "bin": {
    "create-openspec-superpowers-opencode": "dist/cli/create-project.js",
    "openspec-superpowers-opencode": "dist/cli/index.js",
    "oso": "dist/cli/index.js"
  },
  "files": [
    ".gitattributes",
    "assets/",
    "dist/",
    "template/",
    "template/_gitignore",
    "template/.gitattributes",
    "test/",
    "scripts/",
    "docs/QUICKSTART.md",
    "LICENSE"
  ],
  "scripts": {
    "install": "node scripts/shims-installer.js install",
    "test": "npm run typecheck && npm run build && node --test",
    "typecheck": "tsc -p tsconfig.json",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/post-build.mjs"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "@types/node": "26.4.1",
    "tsx": "4.23.13"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "author": "rl <robincn@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moyaspace/openspec-superpowers-opencode.git"
  },
  "bugs": {
    "url": "https://github.com/moyaspace/openspec-superpowers-opencode/issues"
  },
  "homepage": "https://github.com/moyaspace/openspec-superpowers-opencode#readme",
  "publishConfig": {
    "access": "public"
  }
}
